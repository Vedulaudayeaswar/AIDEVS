# ---- Required ----------------------------------------------------------
# One platform-owned Groq key powers every AI agent. Users never supply keys.
GROQ_API_KEY=your-groq-api-key
# 32+ random characters. Generate with: python manage.py gen-secret
JWT_SECRET_KEY=change-me

# ---- Database ----------------------------------------------------------
# Leave empty for local SQLite (backend/instance/aidevs.db).
# Production: Neon free PostgreSQL, e.g. postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# (sslmode=require is added automatically for *.neon.tech hosts; production refuses to start on SQLite)
DATABASE_URL=
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=240
DB_CONNECT_TIMEOUT=15
DB_WAIT_ATTEMPTS=8
# Migrations run automatically on start (set to 0 to run `python manage.py migrate` yourself)
AUTO_MIGRATE=1

# ---- Web ---------------------------------------------------------------
FLASK_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Public URL of this API (used for uploaded image URLs in previews). Render sets RENDER_EXTERNAL_URL.
PUBLIC_API_URL=

# ---- AI model registry (optional; see services/model_registry.py) --------
# Comma-separated fallback chain per task: REQUIREMENTS, UI_PLANNING, FRONTEND,
# CODE_MODIFICATION, VISUAL_EDIT, ERROR_ANALYSIS, CHAT
# AI_MODEL_FRONTEND=openai/gpt-oss-120b,openai/gpt-oss-20b
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=3
AI_DAILY_REQUESTS_PER_USER=60
AI_DAILY_TOKENS_PER_USER=150000
AI_REASONING_EFFORT=low
REPAIR_MAX_ATTEMPTS=2

# ---- Free-plan fair-use limits (admins can override at runtime in /admin) ----
MAX_PROJECTS_PER_USER=3
AI_GENERATIONS_PER_DAY=3
AI_MODIFICATIONS_PER_DAY=15
EXPORTS_PER_DAY=10
MAX_STORAGE_MB_PER_USER=50
MAX_TOTAL_STORAGE_MB=300
MAX_CONCURRENT_JOBS_PER_USER=1
MAX_PAGES_PER_PROJECT=12
MAX_ASSET_MB=3
JOB_TIMEOUT_SECONDS=900
REGISTRATION_OPEN=1

# ---- Shared Groq free-tier capacity ------------------------------------
# Platform-wide AI tokens per rolling 24h; new AI tasks pause (HTTP 503 + Retry-After) when used up
AI_GLOBAL_DAILY_TOKENS=350000
# Fallback per-model tokens/minute until Groq's headers report the real value
GROQ_TPM_LIMIT=8000
# Max seconds to wait for a per-minute window: web requests / background jobs
AI_MAX_WAIT_SECONDS=25
AI_JOB_MAX_WAIT_SECONDS=90

# ---- Jobs / scaling ----------------------------------------------------
# 1 = run the durable job worker inside the web process; 0 = run `python manage.py worker` separately
RUN_WORKER_IN_PROCESS=1
AI_MAX_CONCURRENT_JOBS=2
# Optional (NOT needed for the free single-instance deployment): shared rate limits across instances
REDIS_URL=

# ---- Operations --------------------------------------------------------
# Comma-separated emails that get the admin role at login
ADMIN_EMAILS=
# Number of reverse proxies in front of the API (Render: 1; local: 0)
TRUST_PROXY_HOPS=0
LOG_FORMAT=text
LOG_LEVEL=INFO

# ---- Sessions ----------------------------------------------------------
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
